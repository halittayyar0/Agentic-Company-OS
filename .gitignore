# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Agent virtual computer sandboxes (per-agent isolated workspaces)
agent-sandboxes/

# Operator runtime config (provider keys via Settings UI)
data/

# Local container secret files
.secrets/
.tmp/

# Local Codex/Replit conversation state may contain private context
.conversation/

# Local Node/pnpm launcher shim used by the Codex desktop runtime
.codex-pnpm-shim/

# Playwright UI release-smoke artifacts
playwright-report/
test-results/

# Local endurance evidence (CI uploads these separately)
artifacts/endurance-reports/
