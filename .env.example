# Agentic Company OS environment reference
#
# The packaged API start command optionally loads a root .env file; variables
# already present in the process environment take precedence. Vite variables
# should still be supplied to the UI process. Never commit real credentials.

# API server (safe local defaults)
NODE_ENV=development
PORT=5000
HOST=127.0.0.1
LOG_LEVEL=info
ALLOW_REMOTE_ACCESS=false
TRUSTED_HOSTS=127.0.0.1,localhost
# Combined-runtime compatibility default. Split API/worker deployments reject
# contradictory values: api permits false/unset; worker permits true/unset.
# Multiple workers must share the same durable PostgreSQL database.
SCHEDULER_ENABLED=true
SHUTDOWN_GRACE_MS=20000
# Persisted emergency-stop polling is independent from the scheduler so every
# API replica applies a stop accepted elsewhere.
EMERGENCY_STOP_MONITOR_MS=20000

# Durable runtime topology. Production uses PostgreSQL; PGlite is only
# process-lifetime local development. `start` accepts api/combined, while
# `start:worker` requires worker. Compose configures one API and two workers.
RUNTIME_ROLE=combined
# Every PostgreSQL installation (including combined) requires a distinct 32+
# character key. It authenticates operator request identities and encrypts
# Terminal output, internal commands and split-runtime provider credentials.
# Keep its protected backup with database backups; never expose it to browsers.
RUNTIME_CONTROL_KEY=
# Workers make outbound long-poll requests only and never open an HTTP port.
# RUNTIME_CONTROL_API_URL=http://app:5000/api/internal/runtime-control
SCHEDULER_TICK_MS=5000
TASK_LEASE_MS=90000
TASK_HEARTBEAT_MS=15000
RUNTIME_HEARTBEAT_MS=5000
WORKER_STALE_AFTER_MS=15000
RECOVERY_TARGET_MS=120000
OPS_SAMPLE_MS=60000
OPS_SAMPLE_RETENTION_DAYS=30
OPS_SSE_MAX_CLIENTS=100

# Built-in single-operator authentication. Required for NODE_ENV=production
# and every non-loopback bind. Generate at least 32 random characters.
OPERATOR_AUTH_TOKEN=
# Use OPERATOR_AUTH_TOKEN_FILE instead of OPERATOR_AUTH_TOKEN with container secrets.
# OPERATOR_AUTH_TOKEN_FILE=/run/secrets/operator_auth_token
OPERATOR_SESSION_TTL_MS=43200000
# Stable, non-secret actor label persisted in operator audit records.
OPERATOR_AUDIT_ID=local-operator

# Bounded, per-process API limits. Keep a distributed edge limit for replicas.
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Per-task autonomous execution circuit breakers
# 0 = no lifetime step cap; finite work still obeys token/cost/runtime gates.
MAX_TASK_STEPS=0
MAX_TASK_TOKENS=100000
# Finite-task only and only against provider-reported cost; not a billing cap.
# Continuous lifetime counters stay telemetry: enforce recurring spend at the provider.
MAX_TASK_REPORTED_COST_USD=1
MAX_CONSECUTIVE_TASK_FAILURES=5
# Per-provider-call hard deadline, clamped to 5000-600000 ms.
LLM_REQUEST_TIMEOUT_MS=120000
# Bounded per-step model recovery. Free task pins only fall back to free routes.
MODEL_FALLBACK_MAX_ROUTES=3
MODEL_RETRY_ATTEMPTS_PER_ROUTE=2
MODEL_RETRY_BASE_DELAY_MS=750

# Global runtime capacity circuit breakers
MAX_ACTIVE_AGENTS=64
MAX_OUTSTANDING_TASKS=500
MAX_OUTSTANDING_APPROVALS=200
MAX_MESSAGES_PER_AGENT=5000
MAX_COMPANY_MESSAGES=50000

# Company Room has no separate member cap; its active roster still obeys MAX_ACTIVE_AGENTS.
# Sequential by default so each responder sees earlier replies and avoids repetition.
COMPANY_CHAT_MAX_RESPONSE_ATTEMPTS=6
COMPANY_CHAT_RESPONSE_CONCURRENCY=1
COMPANY_CHAT_RESPONSE_MAX_TOKENS=400
COMPANY_CHAT_RESPONSE_TOKEN_BUDGET=2400

# Meeting rosters add no separate cap beyond MAX_ACTIVE_AGENTS. Execution is bounded.
PROJECT_MEETING_MAX_RESPONDERS_PER_START=8
PROJECT_MEETING_MAX_CONCURRENT_STARTS=2

# Local Vite UI process. It defaults to loopback and proxies /api locally.
LOCAL_API_TARGET=http://127.0.0.1:5000
BASE_PATH=/
DEV_HOST=127.0.0.1
PREVIEW_HOST=127.0.0.1
DEV_ALLOWED_HOSTS=127.0.0.1,localhost

# Exact additional browser origins, comma-separated. Required with remote API access.
# CORS and the Host allowlist are defense-in-depth around built-in authentication.
CORS_ALLOWED_ORIGINS=
# CORS_ALLOWED_ORIGINS=https://company-os.example.com

# Durable PostgreSQL is required in production/remote mode. Leave blank only
# for process-lifetime PGlite in local development.
DATABASE_URL=
# DATABASE_URL_FILE=/run/secrets/database_url
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=60000
# Optional absolute override; packaged builds ship migrations automatically.
# DATABASE_MIGRATIONS_DIR=/absolute/path/to/generated-sql

# The production container serves the built UI and API on one origin.
SERVE_STATIC_UI=false
# STATIC_UI_DIR=/absolute/path/to/artifacts/agentic-company-os/dist/public

# Optional LLM providers. At least one configured provider is needed for agent turns.
OPENROUTER_API_KEY=
# OPENROUTER_API_KEY_FILE=/run/secrets/openrouter_api_key
# Optional attribution origin sent to OpenRouter as HTTP-Referer; does not change its API URL.
APP_PUBLIC_URL=
# Direct OpenAI traffic is pinned in code to https://api.openai.com/v1.
OPENAI_API_KEY=
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
# Optional server-admin allowlist additions. Public model IDs are namespaced as openai:<id>.
OPENAI_MODEL_IDS=
# Local Ollama only: localhost, host.docker.internal, or a private IP literal.
# The endpoint is server configuration and cannot be changed from the browser.
OLLAMA_BASE_URL=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_API_KEY_FILE=/run/secrets/replit_ai_api_key
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Dangerous capabilities are secure-by-default and must stay false on ordinary hosts.
ALLOW_AGENT_PROCESS_EXEC=false
ALLOW_AGENT_SUDO=false
ALLOW_FOUNDER_SHELL=false

# Per-agent workspace and browser settings
# AGENT_SANDBOX_ROOT=C:/absolute/path/to/isolated/agent-sandboxes
# Optional: chrome, msedge, or chromium. Blank uses platform auto-detection.
AGENT_BROWSER_CHANNEL=
# Optional absolute browser executable, used by the production container.
AGENT_BROWSER_EXECUTABLE_PATH=
AGENT_BROWSER_HEADLESS=true
AGENT_BROWSER_ALLOW_PRIVATE_NETWORKS=false
# WebSockets stay off unless required; enabled ws/wss still uses the public-target policy.
AGENT_BROWSER_ALLOW_WEBSOCKETS=false
# Limits are per browser-owning runtime process; idle time is milliseconds (minimum 60000).
MAX_BROWSER_SESSIONS=4
BROWSER_SESSION_IDLE_MS=900000
BROWSER_CONTROL_LEASE_MS=30000
# Optional model-loop override; runtime clamps values to 4-16. Blank uses adaptive limits.
MAX_AGENT_TOOL_ROUNDS=
# Maximum tool calls accepted from one model response; clamped to 1-32.
MAX_AGENT_TOOL_CALLS_PER_ROUND=8

# Endurance-only deterministic runtime. Keep disabled for ordinary development
# and every production deployment. Soak mode additionally requires one atomic
# control file directly inside its run-specific local/mounted temp directory.
SYNTHETIC_RUNTIME_ENABLED=false
# ENDURANCE_MODE=accelerated
# ENDURANCE_RUN_ID=local-endurance-run
# Exact active project roster size, including the coordinator (not minute buckets).
# ENDURANCE_EXPECTED_AGENTS=10
# SYNTHETIC_RUNTIME_SEED=240901
# SYNTHETIC_RUNTIME_FAULT_PLAN=[]
# ENDURANCE_RUN_DIR=C:/absolute/path/to/local-endurance-run
# SYNTHETIC_RUNTIME_CONTROL_FILE=C:/absolute/path/to/local-endurance-run/faults.json
# Docker runner loopback port/base URL overrides:
# APP_PORT=5000
# ENDURANCE_BASE_URL=http://127.0.0.1:5000
# Native Windows runner portable PostgreSQL root (may contain bin recursively):
# ENDURANCE_POSTGRES_ROOT=C:/absolute/path/to/portable-postgresql
