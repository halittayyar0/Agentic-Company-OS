{
  "name": "agentic-company-os",
  "version": "0.3.0",
  "description": "Local-first, human-governed operating system for autonomous AI agent teams.",
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.17 <11"
  },
  "scripts": {
    "setup": "tsx ./scripts/src/setup/bootstrap.ts",
    "evidence:verify": "tsx ./scripts/src/verify-evidence.ts",
    "dev": "pnpm --parallel --filter @workspace/api-server --filter @workspace/agentic-company-os run dev",
    "endurance:accelerated": "tsx ./scripts/src/run-accelerated-endurance.ts",
    "endurance:wall-clock": "tsx ./scripts/src/run-wall-clock-soak.ts",
    "endurance:native-postgres-smoke": "tsx ./scripts/src/run-native-postgres-smoke.ts",
    "endurance:wall-clock:native": "tsx ./scripts/src/run-native-wall-clock-soak.ts",
    "endurance:compare": "tsx ./scripts/src/endurance/compare-reports.ts",
    "endurance:verify-report": "tsx ./scripts/src/endurance/verify-report.ts",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "format:check": "prettier --check .",
    "security:audit": "pnpm audit --prod",
    "test": "tsx ./scripts/src/run-tests.ts",
    "test:ui": "node ./artifacts/agentic-company-os/node_modules/vite/bin/vite.js build --config ./artifacts/agentic-company-os/vite.config.ts && playwright test --config playwright.config.ts",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "verify": "pnpm run format:check && pnpm run security:audit && pnpm --filter @workspace/scripts run check:licenses && pnpm test && pnpm --filter @workspace/db run migrate && pnpm run build && pnpm run test:ui && pnpm --filter @workspace/scripts run check:bundle"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "qs": "6.16.0",
      "fast-uri": "3.1.7",
      "js-yaml": "4.3.2",
      "markdown-it": "14.3.2",
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "prettier": "^3.9.6",
    "tsx": "catalog:",
    "typescript": "~5.9.3"
  }
}
